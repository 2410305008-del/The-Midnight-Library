# ==============================================================================
# PageHaven Bookstore & Curated E-Library Environment Template
# Copy this file to .env and configure your production credentials
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database Connection Credentials
# Format for MongoDB Atlas Cloud:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pagehaven_db?retryWrites=true&w=majority

# Security & JSON Web Token (JWT) Secret
JWT_SECRET=your_production_secure_jwt_random_key_here
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (Comma-separated for multiple origins)
FRONTEND_URL=https://your-pagehaven-domain.vercel.app

# Frontend Client API Endpoint
VITE_API_URL=https://your-pagehaven-backend.onrender.com/api
